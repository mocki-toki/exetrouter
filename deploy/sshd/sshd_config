# Dedicated management instance; do not replace the administrative sshd.
Port 2222
ListenAddress 0.0.0.0
HostKey /etc/ssh/ssh_host_ed25519_key
PidFile /run/exetrouter-sshd.pid
AllowUsers routercli
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthorizedKeysFile /etc/exetrouter/authorized_keys
PermitRootLogin no
StrictModes yes
DisableForwarding yes
PermitTTY no
PermitUserEnvironment no
PermitUserRC no
UsePAM yes
LogLevel VERBOSE
# Per-key forced commands are generated by exrd; no global ForceCommand.
